# Universal AI Chatbot Platform Environment Configuration
# Dedicated configuration isolated from Receipt Extractor

# Environment
CHATBOT_ENV=development
CHATBOT_HOST=0.0.0.0
CHATBOT_PORT=8080
CHATBOT_SECRET_KEY=chatbot-super-secret-key-change-in-production-32bytes
PLATFORM_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Dedicated Chatbot AI Keys (Separate from Receipt Extractor)
# Comma-separated list of Groq keys for automatic rotation on rate limits
CHATBOT_GROQ_API_KEYS=gsk_your_groq_api_key_here
CHATBOT_GROQ_MODEL=llama-3.3-70b-versatile
CHATBOT_GROQ_TIMEOUT=45.0
CHATBOT_GROQ_MAX_RETRIES=2

# Multi-Provider Secondary Fallback (OpenRouter, DeepSeek, Mistral, etc.)
CHATBOT_FALLBACK_PROVIDER=openrouter
CHATBOT_FALLBACK_API_KEY=your_fallback_api_key_here

CHATBOT_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
CHATBOT_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct:free

# MongoDB Platform Database (Stores Platform Data, Tenants, Conversations, Configs)
CHATBOT_MONGODB_URI=mongodb://localhost:27017/
CHATBOT_MONGODB_DB_NAME=chatbot_platform_db
CHATBOT_MONGODB_TIMEOUT_MS=5000

# CORS & Origins
CHATBOT_ALLOWED_ORIGINS=*
