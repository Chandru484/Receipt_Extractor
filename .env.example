# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Groq Fallback API Configuration (auto-fails over if primary key hits rate limit or quota)
GROQ_FALLBACK_API_KEY=your_fallback_groq_api_key_here
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b

# Application & Upload Limits
MAX_UPLOAD_SIZE_MB=10
OCR_LANGUAGE=en

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=receipt_db
MONGODB_COLLECTION=Receipt_Extraction
MONGODB_ENABLED=true
