# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Groq Fallback API Configuration (auto-fails over if primary key hits rate limit or quota)
# You can provide a single fallback key, comma-separated keys, or numbered keys (GROQ_FALLBACK_API_KEY_1, etc.)
GROQ_FALLBACK_API_KEY=your_fallback_groq_api_key_here
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_MAX_COMPLETION_TOKENS=2500

# Multiple Fallback Keys (comma-separated list for cascading failover across multiple keys)
# Example: GROQ_FALLBACK_API_KEYS=gsk_fallback_key2,gsk_fallback_key3,gsk_fallback_key4
GROQ_FALLBACK_API_KEYS=

# Application & Upload Limits
MAX_UPLOAD_SIZE_MB=10
OCR_LANGUAGE=en

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=receipt_db
MONGODB_COLLECTION=Receipt_Extraction
MONGODB_ENABLED=true
